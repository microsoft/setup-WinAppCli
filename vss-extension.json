{
    "manifestVersion": 1,
    "id": "windows-app-development-cli-setup-task",
    "name": "Windows App Development CLI Tasks",
    "version": "0.2.1",
    "publisher": "ms-wpd-winappcli",
    "public": true,
    "targets": [
        {
            "id": "Microsoft.VisualStudio.Services"
        }
    ],    
    "description": "Windows App Development CLI related tasks.",
    "categories": [
        "Azure Pipelines"
    ],
    "icons": {
        "default": "images/extension-icon.png"
    },
    "repository": {
        "type": "git",
        "uri": "https://github.com/Microsoft/setup-WinAppCli"
    },
    "tags": [
        "WinAppCLI",
        "Windows App Development CLI",
        "Windows App Development"
    ],
    "content": {
        "details": {
          "path": "README.md"
        },
        "thirdpartynotice": {
            "path": "licenses.txt"
        },
        "license": {
            "path": "LICENSE"
        }
    },
    "links":{
        "license": {
            "uri": "https://github.com/microsoft/setup-WinAppCli/blob/main/LICENSE"
        }
    },
    "files": [
        {
            "path": "setup-winappcli-task"
        }
    ],
    "contributions": [
        {
            "id": "windows-app-development-cli-setup-task",
            "type": "ms.vss-distributed-task.task",
            "targets": [
                "ms.vss-distributed-task.tasks"
            ],
            "properties": {
                "name": "setup-winappcli-task"
            }
        }
    ]
}