{
  "name": "setup-winappcli",
  "version": "0.2.0",
  "private": true,
  "description": "Setup Windows App Development CLI GitHub Action",
  "main": "lib/src/main.js",
  "scripts": {
    "build": "tsc",
    "format": "prettier --write **/*.ts",
    "format-check": "prettier --check **/*.ts",
    "lint": "eslint src/**/*.ts",
    "copy-license": "copy setup-winappcli-task/licenses.txt licenses.txt || cp setup-winappcli-task/licenses.txt licenses.txt",
    "create-tfx": "npm run copy-license && tfx extension create --manifest-globs vss-extension.json",
    "package": "node build.mjs && npm run create-tfx",
    "test": "jest --detectOpenHandles",
    "all": "npm run build && npm run format && npm run lint && npm run package && npm test"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/microsoft/setup-WinAppCli.git"
  },
  "keywords": [
    "actions",
    "node",
    "setup",
    "winappcli"
  ],
  "author": "Microsoft",
  "license": "MIT",
  "dependencies": {
    "@actions/core": "^3.0.1",
    "@actions/io": "^3.0.2",
    "@actions/tool-cache": "^4.0.0",
    "azure-pipelines-task-lib": "^5.2.8",
    "azure-pipelines-tool-lib": "^2.0.10",
    "fs-extra": "^11.3.4",
    "q": "^1.5.1"
  },
  "overrides": {
    "azure-pipelines-task-lib": "^5.2.8"
  },
  "devDependencies": {
    "@babel/core": "^7.29.7",
    "@babel/preset-env": "^7.29.7",
    "@eslint/compat": "^1.4.1",
    "@eslint/eslintrc": "^3.3.4",
    "@eslint/js": "^9.39.3",
    "@jest/globals": "^30.2.0",
    "@types/fs-extra": "^11.0.4",
    "@types/jest": "^30.0.0",
    "@types/node": "^25.3.5",
    "@types/q": "^1.5.8",
    "@typescript-eslint/eslint-plugin": "^8.56.1",
    "@typescript-eslint/parser": "^8.56.1",
    "babel-jest": "^30.4.1",
    "esbuild": "^0.28.1",
    "eslint": "^9.39.3",
    "eslint-plugin-github": "^6.0.0",
    "eslint-plugin-import": "^2.32.0",
    "eslint-plugin-jest": "^29.15.0",
    "eslint-plugin-prettier": "^5.5.5",
    "globals": "^17.4.0",
    "jest": "^30.2.0",
    "js-yaml": "^4.1.1",
    "prettier": "3.8.1",
    "ts-jest": "^29.4.6",
    "typescript": "^5.9.3"
  }
}
